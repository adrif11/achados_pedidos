{
  "info": {
    "name": "Achados e Perdidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1 - Cadastrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/objeto",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Carteira preta\",\n  \"local\": \"Biblioteca\",\n  \"data\": \"2026-10-10\",\n  \"status\": \"Encontrado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/objetos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lista JSON\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Buscar por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/objeto?id={{id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Atualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/objeto",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Carteira preta\",\n  \"local\": \"Biblioteca\",\n  \"data\": \"2026-10-10\",\n  \"status\": \"Devolvido\",\n  \"id\": \"{{id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Excluir",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/objeto",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
